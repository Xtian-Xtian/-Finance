# Firebase Web SDK configuration (public client config — NOT secrets).
# Never put Admin SDK / service-account credentials in VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3 site key from Firebase console > App Check). Leave blank to disable.
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" to use the local Firebase Emulator Suite (auth:9099, firestore:8080).
VITE_USE_EMULATORS=false
